{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/ui_kits/website/index.html" },
    { "source": "/sitemap.xml", "destination": "https://jungaba-api.onrender.com/v1/sitemap.xml" },
    { "source": "/about", "destination": "https://jungaba-api.onrender.com/v1/seo/about" },
    { "source": "/programs", "destination": "https://jungaba-api.onrender.com/v1/seo/programs" },
    { "source": "/team", "destination": "https://jungaba-api.onrender.com/v1/seo/team" },
    { "source": "/faq", "destination": "https://jungaba-api.onrender.com/v1/seo/faq" },
    { "source": "/contact", "destination": "https://jungaba-api.onrender.com/v1/seo/contact" },
    { "source": "/blog", "destination": "https://jungaba-api.onrender.com/v1/seo/blog" },
    { "source": "/blog/:slug", "destination": "https://jungaba-api.onrender.com/v1/seo/blog/:slug" },
    { "source": "/tags/:slug", "destination": "https://jungaba-api.onrender.com/v1/seo/tags/:slug" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/ui_kits/website/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/ui_kits/website/admin.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/ui_kits/website/config.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/ui_kits/website/api.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
